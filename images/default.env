#
# integration-sandbox image manifest — default
#
# Service pins retain the baseline exercised on 2026-09-28. On 2026-10-13
# the retired ochami PR image was replaced with an immutable PR #169 digest:
# isolated CLI contracts and live boot CRUD pass, but the expanded full-stack
# suite still needs validation on a healthy seeded stack. See
# docs/uc8-completeness-review.md for known release/auth/metadata limitations.
# Prefer a released CLI once it includes the explicit-cluster fix and passes
# these contracts. Do not describe this expanded image combination as fully
# verified until both consecutive CI runs pass.
#
# Other manifests:
#   IMAGES=release      → images/release.env (latest GH Release of each service)
#   IMAGES=edge         → images/edge.env (:main builds, drift detection)
#   IMAGES=release-v1.0 → images/release-v1.0.env (pinned snapshot)
#
# Per-service env vars (e.g. SBX_TOKENSMITH_IMAGE=...) override entries below.
# Switch manifests with `make ci IMAGES=<name>` → looks up images/<name>.env.

# Infra (third-party, version-pinned)
SBX_VAULT_IMAGE=hashicorp/vault:1.21
SBX_LOCALSTACK_IMAGE=localstack/localstack:3
SBX_POSTGRES_IMAGE=postgres:16-alpine

# BMC sims
SBX_SUSHY_IMAGE=quay.io/metal3-io/sushy-tools:latest
SBX_IPMI_SIM_IMAGE=openchami/ipmi-sim:dev

# OpenCHAMI services — verified known-good combination
SBX_SMD_IMAGE=ghcr.io/openchami/smd:v2.20.5
SBX_TOKENSMITH_IMAGE=ghcr.io/openchami/tokensmith:v0.4.2
SBX_BOOT_IMAGE=ghcr.io/openchami/boot-service:v0.3.2
SBX_METADATA_IMAGE=ghcr.io/openchami/metadata-service:v3.5
SBX_FRU_IMAGE=ghcr.io/openchami/fru-tracker:v0.2.5
SBX_POWER_IMAGE=ghcr.io/openchami/pcs:v2.12.1
SBX_MAGELLAN_IMAGE=ghcr.io/openchami/magellan:v0.6.2
# PR #169 fixes explicit cluster selection; immutable multi-platform digest.
# Runtime Commit: 215bda0006c21d0ddcc43a031bf1daeb80553570 (PR build merge).
SBX_OCHAMI_IMAGE=ghcr.io/openchami/ochami@sha256:94a4d4e35287a77f107c4739f53388537a659244f53d8b94d76b80bbc1c52c6b
